{
	"name": "@mcowger/pi-suppress-providers",
	"author": "Matt Cowger",
	"version": "0.1.2",
	"description": "Pi extension that limits which providers appear in model selection by suppressing env vars for non-enabled providers",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"pi-suppress",
		"provider",
		"suppress",
		"enabledProviders"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mcowger/pi-suppress-providers.git"
	},
	"homepage": "https://github.com/mcowger/pi-suppress-providers#readme",
	"bugs": {
		"url": "https://github.com/mcowger/pi-suppress-providers/issues"
	},
	"engines": {
		"bun": ">=1.0"
	},
	"files": [
		"index.ts",
		"src/",
		"README.md"
	],
	"scripts": {
		"postinstall": "lefthook install",
		"check": "bunx tsc --noEmit",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"pack:dry-run": "bun pack --dry-run"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"lefthook": "2.1.6"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "0.74.0",
		"@earendil-works/pi-coding-agent": "0.74.0"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	}
}
